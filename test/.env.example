# API
BASE_API_URL=https://runbonus.online
WS_URL=wss://runbonus.online/app/workout

# JWT (опционально — если пусто, вход по телефону/паролю)
TEST_USER_TOKEN=

# Тестовый пользователь с активированной обувью
TEST_USER_PHONE=+992900000001
TEST_USER_PASSWORD=test1234
TEST_SMS_CODE=

# Пользователь без обуви (для BONUS-001)
TEST_USER_NO_SHOE_PHONE=+992900000002
TEST_USER_NO_SHOE_PASSWORD=test1234

TEST_DEVICE_ID=00000000-0000-4000-8000-000000000001
TEST_SHOE_CODE=SHOE-DEMO-001

# GPS старт (Душанбе)
START_LAT=38.560000
START_LNG=68.780000

# ТЗ: интервал цикла 4000 мс; FAST_MODE=true → 100 мс для CI
CYCLE_INTERVAL_MS=4000
FAST_MODE=false

COORD_STEP=0.000100
FINISH_DURATION_SECONDS=300
APP_VERSION=1.0.0
