PORT=3001
# production — отключает SMS_DEV_CODE
NODE_ENV=development
# Даты в БД читаются в этом поясе
TZ=Asia/Dushanbe

DB_HOST=localhost
DB_PORT=3306
DB_USER=runbonus
DB_PASSWORD=runbonus
DB_NAME=runbonus
JWT_SECRET=change-me-in-production
JWT_ADMIN_SECRET=change-admin-secret
# Лимиты для старого бонусного режима (отображаются в карточке тренировки в админке)
BONUS_PER_KM=3
DAILY_BONUS_LIMIT=10
SHOE_BONUS_LIMIT=200

# Фоновые задачи: автозакрытие тренировок, отчёт в Telegram в 08:00 (false — выключить)
JOBS=true
# Папка загрузок (аватары, чеки)
UPLOADS_ROOT=uploads

# Telegram — уведомления о заказах и наградах, утренний отчёт
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный адрес API (для отправки чека в Telegram по URL, если нужно)
PUBLIC_API_URL=https://runbonus.online

# SMS (OsonSMS) — регистрация и вход по коду
SMS_LOGIN=
SMS_TOKEN=
SMS_SENDER=RunBonus
SMS_SERVER=https://api.osonsms.com
# SMS_DEV_CODE=123456
# Тестовый номер: фиксированный OTP без SMS (работает и в production)
# SMS_TEST_PHONE=939104140
# SMS_TEST_CODE=100103
# Хеш Android для автоподстановки кода (11 символов, выводится в logcat приложения: SMS_APP_HASH=...)
# SMS_APP_HASH=

# Реквизиты мобильного перевода по умолчанию (если таблица кошельков пуста)
# SHOP_ALIF_WALLET=+992 90 000 00 01

# Firebase Cloud Messaging (push-уведомления в приложении)
# Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# или одной строкой JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
