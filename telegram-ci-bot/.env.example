# Скопируйте в /opt/runbonus/telegram-ci.env (chmod 600). Не коммитьте секреты.

TELEGRAM_BOT_TOKEN=
# Один chat id или список через запятую
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_ID=

# Jenkins только во внутренней сети / localhost
JENKINS_URL=http://jenkins:8080
JENKINS_USER=
JENKINS_API_TOKEN=
# Multibranch folder/branch
JENKINS_JOB_PATH=RunBonus/master
