# Скопируйте в .env на VPS. Файл .env в Git не коммитится.
# Секреты также хранятся в Jenkins Credentials.

NODE_ENV=production
PORT=3000

MYSQL_DATABASE=runbonus
MYSQL_USER=runbonus
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

DB_HOST=mysql
DB_PORT=3306
DB_USER=runbonus
DB_PASSWORD=change-me
DB_NAME=runbonus
DATABASE_URL=mysql://runbonus:change-me@mysql:3306/runbonus

REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-in-production
JWT_ADMIN_SECRET=change-admin-secret

CORS_ORIGIN=https://runbonus.online
PUBLIC_API_URL=https://api.runbonus.tj

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

SMS_LOGIN=
SMS_TOKEN=
SMS_SENDER=RunBonus
SMS_SERVER=https://api.osonsms.com

# Docker image tag (Jenkins подставляет сам)
IMAGE_TAG=git-local

# Домен фронта API (nginx)
API_HOST=api.runbonus.tj
