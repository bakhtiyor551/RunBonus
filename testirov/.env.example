# Локально:
# BASE_API_URL=http://localhost:3001
# WS_URL=ws://localhost:3001/app/workout

# Продакшен (как в mobile/.env.production):
BASE_API_URL=https://runbonus.online
WS_URL=wss://runbonus.online/app/workout

# JWT (опционально — если пусто, вход по телефону/паролю ниже)
TEST_USER_TOKEN=

# Телефон и пароль тестового пользователя (создаётся автоматически при первом запуске)
TEST_USER_PHONE=+992900000001
TEST_USER_PASSWORD=test1234

# UUID устройства — фиксированный для CLI-тестов
TEST_DEVICE_ID=00000000-0000-4000-8000-000000000001

# Код кроссовок из seed (SHOE-DEMO-001) — для авто-регистрации
TEST_SHOE_CODE=SHOE-DEMO-001

# Стартовая точка (Душанбе)
START_LAT=38.560000
START_LNG=68.780000

# Интервал цикла, мс (ТЗ: 4000)
CYCLE_INTERVAL_MS=4000

# Шаг координаты за цикл (ТЗ: 0.000100)
COORD_STEP=0.000100

# Сценарий A: число циклов (ТЗ: 20; для status=approved на RunBonus с min 0.5 км нужно ≥45)
SCENARIO_A_CYCLES=45

# Длительность в теле /finish, сек (ТЗ: 80 с реального времени; min на бэкенде — 300)
FINISH_DURATION_SECONDS=300

# Сценарий B: мин. число точек для approved после теста буфера (9 по ТЗ + доп. для 0.5 км)
SCENARIO_B_MIN_POINTS=45
