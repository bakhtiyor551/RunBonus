# API (для apiHelper и получения SMS в dev)
BASE_API_URL=https://runbonus.online

# Android / Appium
ANDROID_APP_PACKAGE=com.runbonus.app
ANDROID_APP_ACTIVITY=com.runbonus.app.MainActivity
APK_PATH=../mobile/android/app/build/outputs/apk/debug/app-debug.apk

# Эмулятор (adb devices)
ANDROID_DEVICE_NAME=emulator-5554
# Оставьте пустым — Appium подберёт версию сам; или укажите 15
ANDROID_PLATFORM_VERSION=

# Тестовый пользователь
TEST_USER_PHONE=+992900000001
TEST_SMS_CODE=
TEST_DEVICE_ID=00000000-0000-4000-8000-000000000001
TEST_SHOE_CODE=SHOE-DEMO-001

# Версия для отчёта
APP_VERSION=1.0.0

# GPS старт (Душанбе)
START_LAT=38.5598
START_LNG=68.7738
