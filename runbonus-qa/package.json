{
  "name": "runbonus-qa",
  "version": "1.0.0",
  "private": true,
  "description": "RunBonus Appium E2E — WebDriverIO + TypeScript",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:release": "wdio run wdio.release.conf.ts",
    "test:nightly": "wdio run wdio.nightly.conf.ts",
    "test:auth": "wdio run wdio.conf.ts --suite auth",
    "test:gps": "wdio run wdio.conf.ts --suite gps",
    "test:running": "wdio run wdio.conf.ts --suite running",
    "test:offline": "wdio run wdio.conf.ts --suite offline",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "report:html": "node scripts/build-html-report.mjs",
    "appium:install-driver": "appium driver install uiautomator2 2>nul || appium driver list --installed",
    "appium:drivers": "appium driver list --installed",
    "appium:doctor": "appium driver doctor uiautomator2",
    "auth:sms-send": "node scripts/sendSms.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/globals": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/reporter": "^9.29.0",
    "@wdio/spec-reporter": "^9.4.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.12.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
